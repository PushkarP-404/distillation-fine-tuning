# ==============================================================================
# Distillation & Fine-Tuning Environment Variables
# Copy this file to '.env' in this directory and fill in your keys:
#   cp .env.template .env
# ==============================================================================

# Groq API Key (Required for 00_generate_synthetic_dataset.py & 01_distill_groq.py)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Teacher Model ID on Groq (default: llama-3.3-70b-versatile)
GROQ_TEACHER_MODEL=llama-3.3-70b-versatile

# Hugging Face Token (Optional, only needed if pushing checkpoints to the Hub)
# HF_TOKEN=your_huggingface_token_here

# VM SSH Credentials (used by apply_lora.py & fetch_dataset.py)
VM_PASSWORD=password_123
